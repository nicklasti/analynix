# Copy this file to .env for local development (.env is not committed to git).
# In production, set these as real environment variables / fly.io secrets instead.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 1 = local development (detailed error pages). Leave unset or 0 in production.
DJANGO_DEBUG=0

# Comma-separated host names the site may be served under.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins, needed for admin logins behind HTTPS, e.g. https://nixreenz.fly.dev
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: where the SQLite database lives (default: db.sqlite3 next to manage.py).
# DATABASE_PATH=/data/db.sqlite3

# Optional: enables the AI analysis step. Without it stocks are graded on the numbers alone.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Seconds to wait between requests to finviz / Yahoo Finance.
SCRAPE_DELAY_SECONDS=2
